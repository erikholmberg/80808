# Song to 808 preview lookup uses Apple’s public iTunes Search API — no key required.
# See src/app/api/song-preview/route.ts

# Optional — extra starter patterns when you press “More”: Vercel AI Gateway (unique grooves via LLM).
# Without AI_GATEWAY_API_KEY, the app falls back to offline random patterns.
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=openai/gpt-4o-mini
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
